{
  "name": "discord-wrapped",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "python3 build.py",
    "check": "node --check src/worker.js && node --check test/node-check.mjs && pnpm build && git diff --exit-code -- public/ && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test test/*.test.mjs",
    "test:release": "node --test .github/scripts/*.test.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "wrangler": "4.151.3"
  }
}
