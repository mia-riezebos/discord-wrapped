{
  "name": "discord-wrapped",
  "account_id": "492214885e7a580ccc1d141dfdb4dc5f",
  "compatibility_date": "2026-10-01",
  // The page does all the message work in the visitor's browser; the Worker only stores share images, renders their
  // pages and forwards sponsor requests.
  "main": "worker/index.js",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/s/*"], "html_handling": "drop-trailing-slash" },
  // The shared sponsor service (mia-cx/sponsors) stores campaigns and footer sponsors for every site.
  "services": [{ "binding": "SPONSORS", "service": "sponsors" }],
  // Share images for share links; the bucket's lifecycle rule (expire-90d) deletes each one after 90 days.
  "r2_buckets": [{ "binding": "SHARES", "bucket_name": "discord-wrapped-shares" }],
  "vars":{ "SPONSOR_SITE": "discordwrapped.app" },
  "routes": [
    { "pattern": "discordwrapped.app", "custom_domain": true },
    { "pattern": "www.discordwrapped.app", "custom_domain": true },
    { "pattern": "wrapped.mia.cx", "custom_domain": true }
  ]
}
